@{
    ViewData["Title"] = "Пополнение баланса";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Пополнение баланса</h2>
                    <div class="mb-3">
                        <label class="form-label">Текущий баланс</label>
                        <p class="form-control-static" id="currentBalance">Загрузка...</p>
                    </div>
                    <div class="mb-3">
                        <label for="amount" class="form-label">Сумма пополнения</label>
                        <input type="number" class="form-control" id="amount" min="1" step="1">
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-primary" onclick="addBalance()">Пополнить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateBalance() {
            fetch('/Balance/GetBalance')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('currentBalance').textContent = data.balance + ' ₽';
                });
        }

        function addBalance() {
            const amount = document.getElementById('amount').value;
            if (!amount || amount <= 0) {
                alert('Введите корректную сумму');
                return;
            }

            fetch('/Balance/AddBalance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ amount: parseFloat(amount) })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Баланс успешно пополнен');
                    updateBalance();
                    document.getElementById('amount').value = '';
                }
            });
        }

        // Обновляем баланс при загрузке страницы
        window.addEventListener('load', updateBalance);
    </script>
} 