@model IEnumerable<hazinDNS_v2.Models.Product>

@{
    ViewData["Title"] = "HazinDNS - Главная";
}

<div class="text-center mb-5">
    <h1 class="display-4">Добро пожаловать в HazinDNS</h1>
    <p class="lead">Ваш магазин бытовой техники</p>
</div>

<div class="container">
    <div class="row g-4">
        @if (ViewBag.SearchQuery != null)
        {
            <div class="row mb-4">
                <div class="col">
                    <h2>Результаты поиска: "@ViewBag.SearchQuery"</h2>
                    <p>Найдено товаров: @Model.Count()</p>
                </div>
            </div>
        }
        else
        {
            <h2>Каталог товаров</h2>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info mt-4">
                @(ViewBag.SearchQuery != null ? "По вашему запросу ничего не найдено" : "В каталоге пока нет товаров")
            </div>
        }

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mt-2">
            @foreach (var product in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card product-card shadow-sm">
                        <div class="product-image-container">
                            <img src="@product.ImageUrl" class="product-image" alt="@product.Name">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text flex-grow-1">@product.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="product-price">@product.Price.ToString("C")</span>
                                <button class="btn btn-primary" onclick="addToCart(@product.Id)">В корзину</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
